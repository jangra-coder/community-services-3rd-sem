# Base URL of the API. Leave empty when:
#   - developing (Vite proxies /api to http://localhost:4000), or
#   - the Express server serves the built app (single-server deployment).
# Set it only when the frontend and API are deployed on different domains,
# e.g. VITE_API_URL=https://eventpass-api.onrender.com
VITE_API_URL=

# Where the Vite dev-server proxies /api requests (development only)
VITE_API_PROXY=http://localhost:4000
