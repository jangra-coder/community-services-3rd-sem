# ---------------------------------------------------------------------------
# EventPass server configuration
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (docker-compose.yml provides this database).
# Hosted database? Append ?sslmode=verify-full (see docs/DEPLOYMENT.md for providers with their own CA).
DATABASE_URL=postgres://eventpass:eventpass@localhost:5432/eventpass

# Secret used to sign organizer login tokens. REQUIRED in production: at least
# 32 random characters (placeholders like this one are rejected on start-up).
# Generate one with:  openssl rand -hex 48
#   or:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Public URL of the web app. Used for CORS and for the link encoded in QR tickets.
# On Render / Railway this can be left unset: it is derived from the platform's URL.
CLIENT_URL=http://localhost:5173

# Display name used in emails and ticket pages
APP_NAME=EventPass

# Optional: require a code to create an organizer account (leave empty to allow anyone)
ORGANIZER_SIGNUP_CODE=

# Email delivery (SMTP). Leave SMTP_HOST empty to log emails to the console instead.
# docker-compose.yml starts Mailpit (SMTP on 1025, web inbox on http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EventPass <no-reply@eventpass.local>"

# Run pending database migrations automatically when the server starts
AUTO_MIGRATE=true

# On start-up the server waits for the database (hosted databases can take a
# moment to become reachable): attempts x delay, default 12 x 5 seconds.
DB_WAIT_ATTEMPTS=12
DB_WAIT_DELAY_MS=5000

# Set to 1 when deployed behind a reverse proxy / load balancer (Render, Railway, Nginx...)
# so rate limiting sees real client IPs. Accepts a hop count, true/false or "loopback".
TRUST_PROXY=0

# IANA time zone used when the server formats dates (ticket emails, scanner messages).
APP_TIMEZONE=Asia/Kolkata

# Serve the built React app (client/dist) from this server. Auto-enabled in production.
SERVE_CLIENT=false
