{
  "name": "@eventpass/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EventPass API – Express + PostgreSQL backend for registrations, QR tickets and check-ins",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
